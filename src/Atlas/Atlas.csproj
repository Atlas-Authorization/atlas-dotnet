<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>Atlas</RootNamespace>
    <AssemblyName>Atlas</AssemblyName>

    <!-- NuGet package metadata -->
    <PackageId>Atlas.Sdk</PackageId>
    <Version>1.0.0</Version>
    <Authors>Atlas</Authors>
    <Company>Atlas</Company>
    <Product>Atlas Backend SDK</Product>
    <Description>Official .NET / C# backend SDK for the Atlas authentication platform. A typed, secret-key management client (users, sessions, organizations, roles, SSO, SCIM, FGA, and more) plus local session-JWT verification against instance JWKS.</Description>
    <PackageTags>atlas;auth;authentication;authorization;sso;saml;scim;jwt;identity</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/atlas/atlas</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- JWT / JWKS verification -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.2.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.2.0" />
  </ItemGroup>

  <!-- System.Text.Json is in-box on net8.0; needs a package on netstandard2.1. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
  </ItemGroup>

</Project>
